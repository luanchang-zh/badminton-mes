# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，真实密钥不要提交。
#
# 注意：不要在这里设置 POSTGRES_WORKSPACE / NEO4J_WORKSPACE / WORKSPACE。
# 这三个变量会覆盖实例级 workspace，导致所有租户被写进同一个命名空间。

# ---------- 目录与存储 ----------
LR_INPUT_DIR=./data/inputs
LR_WORKING_DIR=./data/rag_storage
LR_KV_STORAGE=PGKVStorage
LR_VECTOR_STORAGE=PGVectorStorage
LR_DOC_STATUS_STORAGE=PGDocStatusStorage
LR_GRAPH_STORAGE=Neo4JStorage

# ---------- 模型接入（OpenAI 兼容接口）----------
# 供应商确定后填写；未填时自检只校验配置，不构建真实实例。
LR_LLM_MODEL=
LR_LLM_BASE_URL=
LR_LLM_API_KEY=
LR_LLM_MAX_ASYNC=4

LR_EMBEDDING_MODEL=
LR_EMBEDDING_BASE_URL=
LR_EMBEDDING_API_KEY=
# 向量维度：确定模型后再填，之后不可随意修改，否则已写入的向量需要重建。
LR_EMBEDDING_DIM=
LR_EMBEDDING_MAX_TOKEN_SIZE=8192

# ---------- 检索与容量 ----------
LR_TOP_K=60
# 0 表示不限制待处理文档数；多租户同时索引大文件时建议设置上限。
LR_MAX_PENDING_DOCUMENTS=0
LR_MAX_PARALLEL_INSERT=2

# ---------- HTTP 服务（P2）----------
# 默认只监听回环地址：内部服务不应对局域网暴露。
LR_HOST=127.0.0.1
LR_PORT=9621
# 租户路由的内部访问密钥（对应 X-API-Key），只交给可信业务服务。
# 监听非回环地址时必须配置，否则服务拒绝启动。
LR_INTERNAL_API_KEY=
# 所有租户共享的模型并发上限；留空或 0 表示不限制。
LR_LLM_CONCURRENCY=8
# 是否开放 /docs 与 /openapi.json；内部服务默认关闭。
LR_ENABLE_API_DOCS=false

# ---------- LightRAG 存储连接（容器内或宿主机联调时使用）----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=lightrag

NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# ---------- 依赖组件镜像（默认走国内镜像前缀，可整体替换）----------
LR_PG_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
LR_NEO4J_IMAGE=docker.m.daocloud.io/library/neo4j:5.26-community
LR_PG_DATABASE=lightrag
LR_PG_USER=lightrag
LR_PG_PASSWORD=change-me
LR_NEO4J_USER=neo4j
LR_NEO4J_PASSWORD=change-me-please
